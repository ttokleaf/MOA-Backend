{
  "info": {
    "name": "MOA Backend API",
    "description": "MOA 가계부 백엔드 API 테스트 컬렉션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "👤 테스트 사용자1 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "test-login"]
        }
      }
    },
    {
      "name": "👤 테스트 사용자2 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test-login-user2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "test-login-user2"]
        }
      }
    },
    {
      "name": "👤 현재 사용자 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "🔧 테스트 환경 초기화",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test-setup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "test-setup"]
        }
      }
    },
    {
      "name": "🔍 세션 정보 조회 (디버깅용)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/session-info",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "session-info"]
        }
      }
    },
    {
      "name": "가계부 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"테스트 가계부\",\n  \"description\": \"Postman으로 생성한 가계부입니다\",\n  \"profileImageUrl\": \"https://example.com/image.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks"]
        }
      }
    },
    {
      "name": "내 가계부 목록 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks"]
        }
      }
    },
    {
      "name": "가계부 상세 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks/{{accountBookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks", "{{accountBookId}}"]
        }
      }
    },
    {
      "name": "가계부 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"수정된 가계부\",\n  \"description\": \"Postman으로 수정한 가계부입니다\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks/{{accountBookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks", "{{accountBookId}}"]
        }
      }
    },
    {
      "name": "가계부 삭제",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks/{{accountBookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks", "{{accountBookId}}"]
        }
      }
    },
    {
      "name": "가계부 참여",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participationCode\": \"{{participationCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accountbooks/join",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accountbooks", "join"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountBookId",
      "value": "1"
    },
    {
      "key": "participationCode",
      "value": "your-participation-code-here"
    }
  ]
}
